{
  "name": "ai-engine-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Global AI software-engineering orchestration control plane (Codex + Claude Code + VS Code).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p extensions/vscode/tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "clean": "npm run clean --workspaces --if-present && rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
