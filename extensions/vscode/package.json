{
  "name": "ai-engine-vscode",
  "displayName": "AI Engine",
  "description": "VS Code control-plane UI for the AI Engine orchestration system (Codex + Claude Code).",
  "version": "0.1.0",
  "publisher": "ai-engine-local",
  "private": true,
  "type": "commonjs",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "aiEngine.newTask", "title": "AI: New Task" },
      { "command": "aiEngine.analyze", "title": "AI: Analyze Repository" },
      { "command": "aiEngine.plan", "title": "AI: Plan Task" },
      { "command": "aiEngine.approvePlan", "title": "AI: Approve Plan" },
      { "command": "aiEngine.implement", "title": "AI: Implement Task" },
      { "command": "aiEngine.verify", "title": "AI: Run Verification" },
      { "command": "aiEngine.review", "title": "AI: Review Changes" },
      { "command": "aiEngine.securityReview", "title": "AI: Security Review" },
      { "command": "aiEngine.fix", "title": "AI: Fix Findings" },
      { "command": "aiEngine.resume", "title": "AI: Resume Workflow" },
      { "command": "aiEngine.retry", "title": "AI: Retry Failed Task" },
      { "command": "aiEngine.acknowledgeDivergence", "title": "AI: Acknowledge Git State Divergence" },
      { "command": "aiEngine.approveVerificationCommand", "title": "AI: Approve Verification Command" },
      { "command": "aiEngine.cancel", "title": "AI: Cancel Workflow" },
      { "command": "aiEngine.status", "title": "AI: Show Workflow Status" },
      { "command": "aiEngine.run", "title": "AI: Run Workflow (automatic until approval needed)" },
      { "command": "aiEngine.refresh", "title": "AI: Refresh", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "aiEngine", "title": "AI Engine", "icon": "resources/icon.svg" }]
    },
    "views": {
      "aiEngine": [
        { "id": "aiEngine.taskView", "name": "Task" },
        { "id": "aiEngine.verificationView", "name": "Verification" },
        { "id": "aiEngine.reviewView", "name": "Review Findings" }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node esbuild.config.mjs",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies",
    "clean": "rm -rf dist *.tsbuildinfo *.vsix"
  },
  "dependencies": {
    "@ai-engine/core": "^0.1.0",
    "@ai-engine/orchestrator": "^0.1.0",
    "@ai-engine/config": "^0.1.0",
    "@ai-engine/security": "^0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
